# Copia este archivo como ".env" y llena tus valores reales.
# NUNCA subas el archivo ".env" (con tus keys reales) a un repositorio publico.

# Que proveedor usar para cada tipo de tarea.
# Opciones: claude | deepseek | gemini | mock  (usa "mock" para probar sin gastar creditos)
# Sugerencia: gemini tiene capa gratuita (modelos Flash), ideal para desarrollo/pruebas.
LLM_PROVIDER_TEXT=mock
LLM_PROVIDER_VISION=mock

# API keys (solo necesitas la del proveedor que vayas a usar)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Modelos (opcional, tienen valores por defecto razonables)
CLAUDE_MODEL=claude-sonnet-5
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-3.6-flash

# Rutas (opcional, por defecto usan las carpetas de ejemplo del proyecto)
# OBSIDIAN_VAULT_PATH=
# HANDWRITTEN_NOTES_PATH=
# OUTPUT_PATH=

# --- Notion (sincronizacion Tareas/001_Tareas.md -> Notion, ver sync/) ---
# 1. Crea una integracion interna en https://www.notion.so/my-integrations
#    y copia su "Internal Integration Secret" aqui.
# 2. En tu base de datos de Notion: boton "Compartir" -> invita a esa
#    integracion (si no, la API no puede verla ni escribirla).
# 3. Copia el ID de la base de datos desde su URL (32 caracteres antes de "?v=").
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Nombres de propiedades en tu base de Notion (opcional: solo si tu base
# usa nombres distintos a los de abajo; la propiedad "title" se detecta sola).
# NOTION_PROP_STATUS=Status
# NOTION_PROP_FECHA=Fecha
# NOTION_PROP_PRIORIDAD=Prioridad
# NOTION_PROP_CONTEXTO=Contexto
# NOTION_PROP_ENERGIA=Energía
# NOTION_PROP_PROYECTO=Proyecto
# NOTION_PROP_URL=URL
