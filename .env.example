# Copia este archivo como ".env" y llena tus valores reales.
# NUNCA subas el archivo ".env" (con tus keys reales) a un repositorio publico.

# Que proveedor usar para cada tipo de tarea.
# Opciones: claude | deepseek | gemini | mock  (usa "mock" para probar sin gastar creditos)
# Sugerencia: gemini tiene capa gratuita (modelos Flash), ideal para desarrollo/pruebas.
LLM_PROVIDER_TEXT=mock
LLM_PROVIDER_VISION=mock

# API keys (solo necesitas la del proveedor que vayas a usar)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Modelos (opcional, tienen valores por defecto razonables)
CLAUDE_MODEL=claude-sonnet-5
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-3.6-flash

# Rutas (opcional, por defecto usan las carpetas de ejemplo del proyecto)
# OBSIDIAN_VAULT_PATH=
# HANDWRITTEN_NOTES_PATH=
# OUTPUT_PATH=
